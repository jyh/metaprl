== itt_struct2 substitution2
? <?>
....main....
1. <Γ> ⊢ t1 = t2 ∈ T
2. <Γ> ⊢ C[t2]
3. <Γ>; x: T; t1 = x ∈ T; t2 = x ∈ T ⊢ C[x] Type
====
<Γ> ⊢ C[t1]

BY Itt_struct.substT <<'t1='t2 in {x:'T | ('x='t1 in 'T) and ('x='t2 in 'T)}>> 0

1. [?]
   ....equality....
   <Γ> ⊢ t1 = t2 ∈ {x:T | (x = t1 ∈ T) ∧ x = t2 ∈ T}
2. [?]
   ....main....
   <Γ> ⊢ C[t2]
3. [?]
   ....wf....
   <Γ>; z: {x:T | (x = t1 ∈ T) ∧ x = t2 ∈ T} ⊢ C[z] Type
