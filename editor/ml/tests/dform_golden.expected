== itt_nat reduce_ind_up
? <?>
....main....
1. <Γ> ⊢ x ∈ ℕ
====

1. <Γ>
⊢ Ind(x + 1) where Ind(n) =
     (n = 0 ═⇒ Ind(n) = base)
     ((n > 0) ═⇒ Ind(n) = up[n; Ind(n - 1)]) ≡
  up[x + 1;
     Ind(x) where Ind(n) =
        (n = 0 ═⇒ Ind(n) = base)
        ((n > 0) ═⇒ Ind(n) = up[n; Ind(n - 1)])]

BY rwh unfoldInd 0 thenT rw (addrC [1] (Itt_int_base.reduce_ind_up thenC reduceC)) 0 thenT genAssumT [1] thenT byDefT unfold_nat

