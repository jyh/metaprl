#
# This function computes the result of the prlc command.
# This duplicates the funcationality in filter/filter/prlcomp.ml
#

#
# XXX: JYH: this seems kind of inefficient to me.
# We should fix omake so that the final line can
# just be $(argv).
#
Shell. +=
   prlcomp(argv) =
      setenv(MP_ROOT, $(ROOT))
      setenv(MPLIB, $(LIB))
      setenv(MP_GROUP, $(THEORYNAME))
      setenv(MP_DESCR, $(THEORYDESCR))
      # The platform's path-list separator; filter_main.ml splits on it.
      setenv(MP_INCLUDE, $(concat $(if $(equal $(OSTYPE), Win32), ;, :), $(OCAMLINCLUDES)))
      # On Windows, omake's shell-code does not drain the child's output pipe
      # while the child runs, so a step that writes about 4 KB or more blocks
      # forever (reproduced with a 12-line OMake project and no MetaPRL). There
      # the output goes to a temporary file, copied to stderr byte for byte.
      if $(equal $(OSTYPE), Win32)
         tmp = $(tmpfile prlcomp)
         code = $(shell-code $(argv) >& $(tmp))
         ch = $(fopen $(tmp), rb)
         try
            while true
               fprint($(stderr), $(read $(ch), 4096))
         catch RuntimeException(e)
            value
         close($(ch))
         rm(-f $(tmp))
         export code
      else
         code = $(shell-code $(argv))
         export code
      if $(eq $(code), 0)
         return 1
      else
         exit $(code)

prlc-deps() =
   DEPS[] =
      $(ROOT)
      $(LIB)
      $(THEORYNAME)
      $(THEORYDESCR)
      $(OCAMLINCLUDES)
   return $(DEPS)

#
# Command without a preprocessor
#
WrapC(command) =
   #
   # Put together the command
   #
   COMMAND = prlcomp $(command)

   return($(COMMAND))

#
# Command with a preprocessor
#
PrlC(command) =
   #
   # Put together the command.  This should not be an array,
   # because the alias prlcomp should not be quoted.
   #
   COMMAND = prlcomp $(command) -pp $(quote-argv $(CAMLP5N) $(LOC))

   return($(COMMAND))
