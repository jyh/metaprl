TERM set: false
== hbreak["Y"; "N"]
Perv!xcons
    {Perv!string["a":s];
     Perv!xcons{N; Perv!xcons{Perv!string["b":s]; Perv!xnil}}}
== hbreak[y:s; n:s]
Perv!xcons
    {Perv!string["a":s];
     Perv!xcons{n; Perv!xcons{Perv!string["b":s]; Perv!xnil}}}
== sbreak[y:s; n:s]
Perv!xcons
    {Perv!string["a":s];
     Perv!xcons{n; Perv!xcons{Perv!string["b":s]; Perv!xnil}}}
== cbreak[y:s; n:s]
Perv!xcons
    {Perv!string["a":s];
     Perv!xcons{n; Perv!xcons{Perv!string["b":s]; Perv!xnil}}}
== tzone[t:s]
Perv!xcons{; Perv!xcons{Perv!string["x":s]; Perv!xcons{; Perv!xnil}}}
== tzone["tag"]
Perv!xcons{; Perv!xcons{Perv!string["x":s]; Perv!xcons{; Perv!xnil}}}
== pushm[3]
Perv!xcons{; Perv!xcons{Perv!string["x":s]; Perv!xcons{; Perv!xnil}}}
