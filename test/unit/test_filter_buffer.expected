  empty                              ""
  putc a, puts "bc"                  "abc"
  clear                              ""
  puts 32 bytes (exactly full)       "32"
  then putc (past 32)                "33"
  puts 40 bytes into an empty buffer "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  putc 33 times                      "ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFG"
  puts 20 + 20 + 30                  "70"
