mk_rule_term (sweep_rulequote_term):
  c                          Reflect!lambda{'step. Reflect!spread{'step; 'step, 'witness. Reflect!beq_proof_step{'step; Reflect!proof_step{Reflect!nil; Reflect!mk_term{Reflect!operator[(Test!c{}):op]; Reflect!nil}}}}}
  xunquote{c}                Reflect!lambda{'step. Reflect!spread{'step; 'step, 'witness. Reflect!beq_proof_step{'step; Reflect!proof_step{Reflect!nil; Test!c}}}}
  pair{xunquote{x}; c}       Reflect!lambda{'step. Reflect!spread{'step; 'step, 'witness. Reflect!beq_proof_step{'step; Reflect!proof_step{Reflect!nil; Reflect!mk_term{Reflect!operator[(Test!pair{0; 0}):op]; Reflect!cons{'x; Reflect!cons{Reflect!mk_term{Reflect!operator[(Test!c{}):op]; Reflect!nil}; Reflect!nil}}}}}}}
  <H>[c]                     refused (sweep_rulequote_term: contexts are not supported currently)
  <H>[c] with an argument    refused (sweep_rulequote_term: contexts are not supported currently)
  c --> xunquote{c}          Reflect!lambda{'step. Reflect!spread{'step; 'step, 'witness. Reflect!beq_proof_step{'step; Reflect!proof_step{Reflect!cons{Reflect!mk_term{Reflect!operator[(Test!c{}):op]; Reflect!nil}; Reflect!nil}; Test!c}}}}
  <H>[c] --> c               refused (sweep_rulequote_term: contexts are not supported currently)
  'a[c]                      Reflect!lambda{'step. Reflect!spread{'step; 'step, 'witness. Reflect!let_sovar["a":s]{Reflect!number[1:n]; 'witness; Reflect!number[0:n]; 'a. Reflect!beq_proof_step{'step; Reflect!proof_step{Reflect!nil; Reflect!subst{'a; Reflect!mk_term{Reflect!operator[(Test!c{}):op]; Reflect!nil}}}}}}}
  sequent <J> >- c           Reflect!lambda{'step. Reflect!spread{'step; 'step, 'witness. Reflect!let_cvar["J":s]{Reflect!number[0:n]; 'witness; Reflect!number[0:n]; 'J. Reflect!beq_proof_step{'step; Reflect!proof_step{Reflect!nil; Reflect!sequent_bterm{Reflect!number[0:n]; Arg: Reflect!vsequent{Reflect!mk_term{Reflect!operator[(Test!sa{}):op]; Reflect!nil}} Hyps: 1._ :'J Goal:Reflect!bind{Reflect!length{'J}; 'J. Reflect!mk_term{Reflect!operator[(Test!c{}):op]; Reflect!nil}}}}}}}}
