hand cases (code vs OCaml's free variables):
  a                              [a]        agree
  a b                            [a,b]      agree
  (a, b, a)                      [a,b]      agree
  1                              []         agree
  fun x -> x y                   [y]        agree
  if a then b else c             [a,b,c]    agree
  do { a; b }                    [a,b]      agree
  let x = a in b                 [a,b]      agree
  let x = a in x                 [a]        agree
  let x = a in x b               [a,b]      agree
  let x = a and y = x in y       [a,x]      agree
  let rec f = f in f             []         agree
  let rec f = g in b             [b,g]      agree
  match a with x when g -> b     [a,b,g]    agree
  match a with x when x -> x     [a]        agree
  try a with x -> b              [a,b]      agree
  fun x when g -> x              [g]        agree
patt_vars:
  x                              [x]
  _                              []
  (x, y, x)                      [x,y]
  (x : t)                        [x]
new_vars [x; y; z] in x0 (x1 y0): [x2,y1,z0]
new_vars [x] in let q = a in x0: [x1]
model, 2000 random expressions (depth 1-3, names a b x y):
  no let, no guard   0 of 855 disagree
  with a let         0 of 459 disagree
  with a let rec     0 of 463 disagree
  with a guard       0 of 822 disagree
  all                0 of 2000 disagree
