(EmptyVar, 5)                      string ""                       symbol "_5"                     back (EmptyVar, 0)
(Atom, 5)                          string "a5"                     symbol "a5"                     back (Atom, 5)
(Const 0, 5)                       string "c5"                     symbol "c5"                     back (Const 0, 5)
(Const 3, 5)                       string "c3_5"                   symbol "c3__5"                  back raises Invalid_argument("String.sub / Bytes.sub")
(Dummy, 5)                         string "d5"                     symbol "d5"                     back (Dummy, 5)
(EigenVar, 5)                      string "e5"                     symbol "e5"                     back (EigenVar, 5)
(Var 0, 5)                         string "v5"                     symbol "v5"                     back (Var 0, 5)
(Var 3, 5)                         string "v3_5"                   symbol "v3__5"                  back raises Invalid_argument("String.sub / Bytes.sub")
(NewVar 0, 5)                      string "n5"                     symbol "n5"                     back (NewVar 0, 5)
(NewVar 3, 5)                      string "n3_5"                   symbol "n3__5"                  back raises Invalid_argument("String.sub / Bytes.sub")
(NewVarQ 0, 5)                     string "q5"                     symbol "q5"                     back (NewVarQ 0, 5)
(NewVarQ 3, 5)                     string "q3_5"                   symbol "q3__5"                  back raises Invalid_argument("String.sub / Bytes.sub")
(Root, 5)                          string "w"                      symbol "w5"                     back (Root, 0)
(GammaPos (Atom), 5)               string "a_jprover5"             symbol "a_jprover5"             back (GammaPos (Atom), 5)
(GammaPos (Var 0), 5)              string "v_jprover5"             symbol "v_jprover5"             back (GammaPos (Var 0), 5)
(GammaPos (GammaPos (Const 0)), 5) string "c_jprover_jprover5"     symbol "c_jprover_jprover5"     back (GammaPos (GammaPos (Const 0)), 5)
(GammaPos (Var 3), 5)              string "v3__jprover5"           symbol "v3__jprover5"           back raises Invalid_argument("String.sub / Bytes.sub")
gamma_to_simple / simple_to_gamma:
  (GammaPos (Atom), 2)             simple (Atom, 2)  gamma (GammaPos (GammaPos (Atom)), 2)
  (GammaPos (GammaPos (Atom)), 2)  simple (GammaPos (Atom), 2)  gamma (GammaPos (GammaPos (GammaPos (Atom))), 2)
  (Atom, 2)                        simple raises Invalid_argument("GammaPos was expected instead of: a2")  gamma (GammaPos (Atom), 2)
  (Root, 0)                        simple raises Invalid_argument("GammaPos was expected instead of: w")  gamma (GammaPos (Root), 0)
