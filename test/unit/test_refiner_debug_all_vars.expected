no renaming: all_vars                        {x, y}
no renaming: all_vars_terms                  {x, y}
no renaming: free_vars_set                   {y}
renamed alike: all_vars                      {x, x1}
renamed alike: all_vars_terms                {x, x1}
renamed alike: free_vars_set                 {x}
[y := x; z := x1]: all_vars                  {x, x1, x2}
[y := x; z := x1]: all_vars_terms            {x, x1, x2}
[y := x; z := x1]: free_vars_set             {x}
[y := x; z := x1; w := x2]: all_vars         {x, x1, x3}
[y := x; z := x1; w := x2]: all_vars_terms   {x, x1, x3}
[y := x; z := x1; w := x2]: free_vars_set    {x}
