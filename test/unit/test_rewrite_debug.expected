== every parameter kind
Rewrite.apply_rewrite: match_redex on p[7:n, "str":s, "k":t, {1 | 'j}:l, 3:n, "x":s, "tok":t]{c}
Rewrite.match_redex: 0
 RWComposite p@0:n; @1:s; @2:t; (1 [3 0]); 3:n; x:s; tok:t
    Bterm 0()
       RWSOVar (4, )
Rewrite.match_redex.RWComposite: p[7](1)/p[7:n, "str":s, "k":t, {1 | 'j}:l, 3:n, "x":s, "tok":t]{c}[7](1)
Rewrite.match_redex_params.RWMNumber: stack(0)/5 <- 7
Rewrite.match_redex_params.RWMString: stack(1)/5 <- str
Rewrite.match_redex_params.RWMToken: stack(2)/5 <- k
Rewrite.match_redex_params.RWMLevel2: stack/5
Rewrite.match_redex.RWSOVar: stack(4)/5 with c
	RWSoVar: Void
Rewrite.match_redex.RWComposite done
Rewrite.apply_rewrite: build_contractum
Rewrite.build_contractum:
 RWComposite q@0:n; @1:s
    Bterm 0()
       RWSOInstance (4)
Stack: 5
	Number 7
	String str
	Opname k
	Level
	BTerm c[]

Rewrite.apply_rewrite: done, result: [q[7:n, "str":s]{c}]
-> q[7:n, "str":s]{c}
== a binder and a second-order variable
Rewrite.apply_rewrite: match_redex on h{lam{'y. f{'y}}}
Rewrite.match_redex: 0
 RWComposite h
    Bterm 0()
       RWComposite lam
          Bterm 1(stack:0 (default x))
             RWSOVar (1, 0)
Rewrite.match_redex.RWComposite: h[0](1)/h{lam{'y. f{'y}}}[0](1)
Rewrite.match_redex.RWComposite: lam[0](1)/lam{'y. f{'y}}[0](1)
Rewrite.set_bvars 1/1
Rewrite.set_bvars: stack(0)/2 with y
Rewrite.match_redex.RWSOVar: stack(1)/2 with f{'y}
	RWSoVar: Void
Rewrite.match_redex.RWComposite done
Rewrite.match_redex.RWComposite done
Rewrite.apply_rewrite: build_contractum
Rewrite.build_contractum:
 RWSOInstance (1)
    RWCompositeSimple c
Stack: 2
	Var y
	BTerm f{'y}[y]

Rewrite.apply_rewrite: done, result: [f{c}]
-> f{c}
== no match
-> refused (Rewrite.apply_rewrite)
== flag off
-> c
