Hyps:
      1.y :e
      2.x :d
      3.w :g
Goal:b
Rewrite.match_redex: 0
 RWSequent:
 Arg:
    RWComposite sa
 Hyps:
    RWSeqContext (0, 0, [])
    RWSeqHyp: stack:2 (default x)
       RWSOVar (1, )
    RWSeqContext (-1, 3, [2])
 Goals:
    RWSOVar (4, 2)
Rewrite.match_redex.RWComposite: sa[0](0)/sa[0](0)
Rewrite.match_redex.RWComposite done
RWSeqContext/RWSeqFreeVarsContext (1, 0, [])
RWSeqHyp (1 out of 3)
