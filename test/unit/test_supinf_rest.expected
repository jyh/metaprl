== AF infinities
mk_number +oo: isPlusInfinity true · mk_number -oo: isMinusInfinity true
+oo + +oo  = (++oo1)
-oo + -oo  = (+-oo1)
+oo + -oo  = Invalid_argument: MinusInfinity+PlusInfinity is undefined
-oo + +oo  = Invalid_argument: MinusInfinity+PlusInfinity is undefined
+oo + 1    = (++oo1)
1 + -oo    = (+-oo1)
== term_of
AF 2*x1 + 3       add{3/1; mul{2/1; x1}}
AF x2 - x3        add{mul{1/1; x2}; mul{-1/1; x3}}
AF x1 - x1        0/1
AF 5              5/1
AF x3             mul{1/1; x3}
SAF affine        add{3/1; mul{2/1; x1}}
SAF max           max{add{3/1; mul{2/1; x1}}; add{mul{1/1; x2}; mul{-1/1; x3}}}
SAF min           min{add{3/1; mul{2/1; x1}}; add{mul{1/1; x2}; mul{-1/1; x3}}}
SAF min(max,_)    min{max{add{3/1; mul{2/1; x1}}; add{mul{1/1; x2}; mul{-1/1; x3}}};
     add{3/1; mul{2/1; x1}}}
