== compress_arglist / expand_arglist
String name, String s              String         expands back: true
String name, Bool true             Bool           expands back: true
String name, Int 3                 Int            expands back: true
String name, Term T                Term           expands back: true
String name, String s, String s2   StringString   expands back: true
String name, String s, Bool false  StringBool     expands back: true
String name, String s, Int 4       StringInt      expands back: true
String name, String s, Term U      StringTerm     expands back: true
String name, Bool true, String s2  BoolString     expands back: true
String name, Bool true, Bool false BoolBool       expands back: true
String name, Bool true, Int 4      BoolInt        expands back: true
String name, Bool true, Term U     BoolTerm       expands back: true
String name, Int 3, String s2      IntString      expands back: true
String name, Int 3, Bool false     IntBool        expands back: true
String name, Int 3, Int 4          IntInt         expands back: true
String name, Int 3, Term U         IntTerm        expands back: true
String name, Term T, String s2     TermString     expands back: true
String name, Term T, Bool false    TermBool       expands back: true
String name, Term T, Int 4         TermInt        expands back: true
String name, Term T, Term U        TermTerm       expands back: true
String name                        None           expands back: true
