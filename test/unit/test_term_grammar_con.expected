terms:
  !x!                                refused: Stream.Error("[word_or_string] expected after '!' (in [opname_list])")
  ! x !                              refused: Stream.Error("[word_or_string] expected after '!' (in [opname_list])")
  !(x + y)!                          refused: Stream.Error("[var] expected after '!' (in [nonwordterm])")
  !1!                                refused: Stream.Error("[var] expected after '!' (in [nonwordterm])")
  !"s"!                              refused: Stream.Error("[word_or_string] expected after '!' (in [opname_list])")
  !x{}!                              refused: Stream.Error("[var] expected after '!' (in [nonwordterm])")
  !lam{x. x}!                        refused: Stream.Error("[var] expected after '!' (in [nonwordterm])")
  !'x!                               refused: Stream.Error("[var] expected after '!' (in [nonwordterm])")
  !(x)!                              refused: Stream.Error("[var] expected after '!' (in [nonwordterm])")
  foo                                Construct(foo; []; {})
  foo!bar                            Construct(bar!foo; []; {})
  foo[]                              Construct(foo; []; {})
  foo{}                              Construct(foo; []; {})
  foo{a; b}                          Construct(foo; []; {Construct(a; []; {}); Construct(b; []; {})})
  foo{x. a}                          Construct(foo; []; {x. Construct(a; []; {})})
  foo{x, y. a}                       Construct(foo; []; {x,y. Construct(a; []; {})})
  foo[3]                             Construct(foo; [Num 3:n]; {})
  foo["s"]                           Construct(foo; [Str s:s]; {})
  foo[x:s]                           Construct(foo; [Meta x:s]; {})
  foo[x:t]                           Construct(foo; [Token x:t]; {})
  foo[x:v]                           Construct(foo; [Meta x:v]; {})
  foo[x:l]                           Construct(foo; [Meta x:l]; {})
  foo[x:sh]                          Construct(foo; [Meta x:sh]; {})
  foo[x:op]                          Construct(foo; [Meta x:op]; {})
  foo[x:zz]                          refused: Filter_type.BadParamCast(_, "zz")
  foo[3]{a}                          Construct(foo; [Num 3:n]; {Construct(a; []; {})})
antiquotations:
  $e$                                refused: Stream.Error("entry [expr] is empty")
  foo{$v$. a}                        refused: Stream.Error("entry [expr] is empty")
sequents:
  sequent { >- a }                   Sequent(Term(sequent_arg);  >- Construct(a; []; {}))
  sequent { x: a >- b }              Sequent(Term(sequent_arg); Hyp((Lm_symbol.add "x"): Construct(a; []; {})) >- Construct(b; []; {}))
  sequent [arg] { a; b >- c }        Sequent(Construct(arg; []; {}); Hyp(Lm_symbol.empty_var: Term(a)); Hyp(Lm_symbol.empty_var: Term(b)) >- Construct(c; []; {}))
  sequent (arg) { >- }               Sequent(Construct(arg; []; {});  >- Term(Perv!xconcl))
  sequent { <H> >- a }               Sequent(Term(sequent_arg); Context("H"; ) >- Construct(a; []; {}))
  sequent { <H>; <J[a; b]> >- c }    Sequent(Term(sequent_arg); Context("H"; ); Context("J"; Construct(a; []; {}), Construct(b; []; {})) >- Construct(c; []; {}))
  sequent { <J[]> >- c }             refused: Stream.Error("[con_termlist] expected after '[' (in [con_brtermlist])")
  sequent { foo[3]{a} >- b }         Sequent(Term(sequent_arg); Hyp(Lm_symbol.empty_var: Construct(foo; [Num 3:n]; {Construct(a; []; {})})) >- Construct(b; []; {}))
  sequent { foo >- b }               Sequent(Term(sequent_arg); Hyp(Lm_symbol.empty_var: Term(foo)) >- Construct(b; []; {}))
