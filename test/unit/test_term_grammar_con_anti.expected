antiquotations, with camlp5's OCaml parser linked:
  $e$                                Expr(e)
  $f x$                              Expr((f x))
  '$arg:2$                           Var(argv.(2))
  $arg:3$                            Expr(argv.(3))
  foo{$v$. a}                        Construct(foo; []; {$v. Construct(a; []; {})})
  foo[$n$:n]                         Construct(foo; [Expr n:n]; {})
  foo[$int:n$]                       Construct(foo; [Int n:n]; {})
  sequent { $list:hs$ >- a }         Sequent(Term(sequent_arg); HypList(hs) >- Construct(a; []; {}))
  sequent { $arg:4$: a >- b }        Sequent(Term(sequent_arg); Hyp(argv.(4): Construct(a; []; {})) >- Construct(b; []; {}))
  sequent { $h$: a >- b }            Sequent(Term(sequent_arg); Hyp(h: Construct(a; []; {})) >- Construct(b; []; {}))
  sequent { $list:hs$; x: a >- b }   Sequent(Term(sequent_arg); HypList(hs); Hyp((Lm_symbol.add "x"): Construct(a; []; {})) >- Construct(b; []; {}))
  $1 +$                              refused: Stream.Error("[expr] expected after '+' (in [expr])")
  foo{$1 +$. a}                      refused: Stream.Error("[expr] expected after '+' (in [expr])")
  sequent { $list:1 +$ >- a }        refused: Stream.Error("[expr] expected after '+' (in [expr])")
  sequent { $1 +$: a >- b }          refused: Stream.Error("[expr] expected after '+' (in [expr])")
