  foo[3]                 [TyNumber]
  foo[-3]                [TyNumber]
  foo["s"]               [TyString]
  foo[x]                 [TyString]
  foo[a!b]               [TyToken $unknown!token]
  foo[x']                [TyString]
  foo[x | y]             [TyLevel]
  foo[3 | x]             [TyLevel]
  foo[ @ ]               [TyQuote]
  foo[1, @]              [TyNumber; TyQuote]
  foo[3; x]              refused: Stream.Error("',' or ']' expected (in [ty_params])")
  foo[3, x, "s"]         [TyNumber; TyString; TyString]
  foo[3:n, x]            [TyNumber; TyString]
  foo[x, y:t]            [TyString; TyToken Perv!Token]
  foo                    []
