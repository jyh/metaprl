#
# Don't try to scan files in this directory.
# List the dependencies explicitly.
#
.SCANNER: scan-ocaml-%.mli scan-ocaml-%.ml:
    @

OCAMLDEP = $(file ocamldep$(EXE))
BINDEP   = $(file $(BIN)/ocamldep$(EXE))

#
# We also use our own version of ocamldep
#
OCamlProgramInstall($(MPINSTALL), $(BIN), ocamldep, ocamldep)

ocamldep$(EXT_OBJ) ocamldep.cmx ocamldep.cmo ocamldep.cmi: $(BIN)

#
# Phony targets
#
clean:
    $(CLEAN) *.cm* *~ ocamldep.ml *.o *.exe Makefile.dep ocamldep ocamldep.opt ocamldep.run macropp macroprint

#
# Macros
#
# macropp and macroprint are camlp5 drivers with pa_macro linked in.
# camlp5 8 no longer installs Odyl_main's .cmi, so the old macro_main.ml
# (a one-line call to Odyl_main.go) cannot be compiled.  We link with
# camlp5's own mkcamlp5, which supplies the odyl main and the libraries
# camlp5.cma needs (compiler-libs, pcre2, fmt, camlp-streams).
#
OCAMLINCLUDES += $(CAMLP5LIB) $(CAMLP_STREAMS_LIB)
OCAMLFLAGS += -pp $(quote-argv $(CAMLP5R) -I $(CAMLP5LIB) -nolib $(LOC))

%.cmx %$(EXT_OBJ): $(CAMLP5R_VERSION)
%.cmo: $(CAMLP5R_VERSION)
%.cmi: $(CAMLP5R_VERSION)

# `mkcamlp5 -opt`, not `mkcamlp5.opt`: camlp5 picks native mode by matching
# its own program name against `mkcamlp5.opt$`, which fails on Windows
# (`mkcamlp5.opt.exe`), so it handed the .cmx files to ocamlc.
if $(NATIVE_ENABLED)
    MKCAMLP5 = mkcamlp5 -opt
    MACRO_EXT = .cmx
    MACRO_DEPS = pa_macro.cmx pa_macro$(EXT_OBJ)
    export
else
    MKCAMLP5 = mkcamlp5
    MACRO_EXT = .cmo
    MACRO_DEPS = pa_macro.cmo
    export

MacroProgram(name, printer) =
    $(name)$(EXE): $(MACRO_DEPS)
        $(MKCAMLP5) -I $(CAMLP5LIB) pa_o$(MACRO_EXT) q_MLast$(MACRO_EXT) pa_macro$(MACRO_EXT) pa_extend$(MACRO_EXT) $(addsuffix $(MACRO_EXT), $(printer)) -o $@

    LibInstall($(name)$(EXE))

MacroProgram(macropp, pr_dump)
MacroProgram(macroprint, $(CAMLP5_PR_O))
